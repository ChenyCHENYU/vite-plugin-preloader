{
  "name": "vite-plugin-preloader",
  "version": "2.3.0",
  "description": "Vite 智能路由预加载插件 - dev 注入 modulepreload，build 运行时注入 prefetch",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "sideEffects": false,
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    }
  },
  "files": [
    "dist/index.js",
    "dist/index.mjs",
    "dist/index.d.ts",
    "dist/index.d.mts",
    "docs",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "keywords": [
    "vite",
    "vite-plugin",
    "preload",
    "prefetch",
    "modulepreload",
    "lazy-loading",
    "routes",
    "performance"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "prepublishOnly": "npm run type-check && npm run test && npm run build",
    "test": "vitest run",
    "test:watch": "vitest --watch",
    "format": "prettier --write src/",
    "type-check": "tsc --noEmit"
  },
  "peerDependencies": {
    "vite": "^8.0.0 || ^7.0.0 || ^6.0.0 || ^5.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.13.9",
    "happy-dom": "^21.0.4",
    "prettier": "^3.5.3",
    "tsup": "^8.3.5",
    "typescript": "~5.8.0",
    "vite": "^8.0.1",
    "vitest": "^3.0.8"
  },
  "engines": {
    "node": ">=20.19.0"
  },
  "author": "CHENY <ycyplus@gmail.com>",
  "license": "MIT",
  "homepage": "https://github.com/ChenyCHENYU/vite-plugin-preloader#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ChenyCHENYU/vite-plugin-preloader.git"
  },
  "bugs": {
    "url": "https://github.com/ChenyCHENYU/vite-plugin-preloader/issues"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}
